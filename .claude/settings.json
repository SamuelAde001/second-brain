{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git ls-remote:*)",
      "PowerShell"
    ],
    "ask": [
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(rd *)",
      "PowerShell(rmdir *)",
      "PowerShell(Clear-Content *)",
      "PowerShell(Stop-Process *)",
      "PowerShell(Stop-Service *)",
      "PowerShell(Restart-Computer *)",
      "PowerShell(Stop-Computer *)",
      "PowerShell(Set-ExecutionPolicy *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(reg *)",
      "PowerShell(schtasks *)",
      "PowerShell(Register-ScheduledTask *)",
      "PowerShell(Unregister-ScheduledTask *)",
      "PowerShell(winget *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.key)",
      "Read(./**/credentials*.json)",
      "Read(./**/token*.json)",
      "Read(//c/Users/repzy/.brain-secrets/**)",
      "Read(~/.brain-secrets/**)",
      "PowerShell(*brain-secrets*)",
      "PowerShell(*ANTHROPIC_API_KEY*)"
    ]
  }
}
