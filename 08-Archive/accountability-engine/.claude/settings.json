{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./PA.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/pull.sh\"",
            "timeout": 30,
            "statusMessage": "Pulling the engine from GitHub..."
          }
        ]
      }
    ]
  }
}
